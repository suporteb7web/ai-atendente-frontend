# URL do backend (ai-atendente-backend).
# O navegador nunca fala direto com ele: chama /api/backend/* no Next, que repassa
# para cá (sem CORS) e adiciona o Authorization: Bearer no servidor.
BACKEND_URL=http://localhost:3000
# Token do backend (API_TOKEN dele; no Compose local é dev-token). Fica só no servidor, nunca vai para o navegador.
BACKEND_API_TOKEN=dev-token
